<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <!-- Artwork thumbnail -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/track_artwork"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_git"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.OneUI.ArtworkSmall" />

    <!-- Title & Artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Song Title" />

        <TextView
            android:id="@+id/track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Artist Name • 3:45" />

    </LinearLayout>

    <!-- Like action -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_track_like"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_oui_heart_outline"
        android:tint="?attr/colorControlNormal"
        android:contentDescription="@string/action_favorite" />

    <!-- More menu action -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_track_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_oui_more"
        android:tint="?attr/colorControlNormal"
        android:contentDescription="@string/action_more" />

</LinearLayout>
