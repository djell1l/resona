<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.widget.RoundedLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    app:roundedCorners="top_left|top_right">

    <!-- One UI 8 Player Header Bar (Down Arrow, Title, More) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_player_collapse"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_collapse"
            android:src="@drawable/ic_oui_chevron_down"
            android:tint="?attr/colorControlNormal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/player_now_playing"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_player_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_more"
            android:src="@drawable/ic_oui_more"
            android:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <!-- Album Artwork Squircle (Continuous Curvature 26dp) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/player_artwork"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:elevation="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_git"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.OneUI.ArtworkLarge" />

            <!-- Track Title (Marquee) -->
            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Resona Track Title" />

            <!-- Artist Name (Clickable) -->
            <TextView
                android:id="@+id/player_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="?attr/colorPrimaryDark"
                android:textSize="14sp"
                tools:text="Artist Name" />

            <!-- Seek Bar & Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.SeslSeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="0" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:id="@+id/player_time_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="00:00"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/player_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="00:00"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Main Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_shuffle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_shuffle"
                    android:src="@drawable/ic_oui_shuffle"
                    android:tint="?attr/colorControlNormal" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_prev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_previous"
                    android:src="@drawable/ic_oui_skip_backward"
                    android:tint="?attr/colorControlNormal" />

                <!-- Prominent Play/Pause Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_player_play_pause"
                    style="@style/OneUI.FloatingActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:contentDescription="@string/player_play"
                    android:src="@drawable/ic_oui_play"
                    app:fabCustomSize="64dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_next"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_next"
                    android:src="@drawable/ic_oui_skip_forward"
                    android:tint="?attr/colorControlNormal" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_repeat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_repeat"
                    android:src="@drawable/ic_oui_repeat"
                    android:tint="?attr/colorControlNormal" />

            </LinearLayout>

            <!-- Bottom Utility Row: Favorite, Sound Mode, Lyrics, Queue -->
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="?attr/roundedCornerColor"
                android:gravity="center"
                android:orientation="horizontal"
                app:roundedCorners="all">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_fav"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_favorite"
                    android:src="@drawable/ic_oui_heart_outline"
                    android:tint="?attr/colorControlNormal" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_sound_mode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sound mode"
                    android:src="@drawable/ic_oui_sound_mode"
                    android:tint="?attr/colorControlNormal" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_lyrics"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_lyrics"
                    android:src="@drawable/ic_oui_lyrics"
                    android:tint="?attr/colorControlNormal" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_player_queue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_queue"
                    android:src="@drawable/ic_oui_queue"
                    android:tint="?attr/colorControlNormal" />

            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

        </LinearLayout>
    </ScrollView>

</dev.oneuiproject.oneui.widget.RoundedLinearLayout>
