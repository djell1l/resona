<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.savoo.scclient.ui.screens.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_search"
        android:name="com.savoo.scclient.ui.screens.search.SearchFragment"
        android:label="@string/nav_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/nav_favorites"
        android:name="com.savoo.scclient.ui.screens.favorites.FavoritesFragment"
        android:label="@string/nav_favorites"
        tools:layout="@layout/fragment_favorites" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.savoo.scclient.ui.screens.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nav_artist"
        android:name="com.savoo.scclient.ui.screens.artist.ArtistFragment"
        android:label="@string/artist_title"
        tools:layout="@layout/fragment_artist">
        <argument
            android:name="userId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/nav_playlist"
        android:name="com.savoo.scclient.ui.screens.playlist.PlaylistFragment"
        android:label="@string/playlist_title"
        tools:layout="@layout/fragment_playlist">
        <argument
            android:name="playlistId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/nav_charts"
        android:name="com.savoo.scclient.ui.screens.charts.ChartsFragment"
        android:label="@string/charts_title"
        tools:layout="@layout/fragment_charts" />

    <fragment
        android:id="@+id/nav_history"
        android:name="com.savoo.scclient.ui.screens.history.HistoryFragment"
        android:label="@string/history_title"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/nav_offline"
        android:name="com.savoo.scclient.ui.screens.offline.OfflineTracksFragment"
        android:label="@string/shortcut_offline_short"
        tools:layout="@layout/fragment_offline_tracks" />

</navigation>
